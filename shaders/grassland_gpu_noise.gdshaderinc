    -0.923879532511287, -0.38268343236509, -0.99144486137381, -0.130526192220052, -0.99144486137381, 0.130526192220051, -0.923879532511287, 0.38268343236509,
    -0.793353340291235, 0.608761429008721, -0.608761429008721, 0.793353340291235, -0.38268343236509, 0.923879532511287, -0.130526192220052, 0.99144486137381,
    0.38268343236509, 0.923879532511287, 0.923879532511287, 0.38268343236509, 0.923879532511287, -0.38268343236509, 0.38268343236509, -0.923879532511287,
    -0.38268343236509, -0.923879532511287, -0.923879532511287, -0.38268343236509, -0.923879532511287, 0.38268343236509, -0.38268343236509, 0.923879532511287
);
const int GRASS_PRIME_X = 501125321;
const int GRASS_PRIME_Y = 1136930381;
int grass_noise_floor(float x) { return x >= 0.0 ? int(x) : int(x) - 1; }
float grass_noise_grad(int seed, int x, int y, float dx, float dy) {
 int h = int(uint(seed ^ x ^ y) * uint(0x27d4eb2d));
 h ^= h >> 15;
 h &= 254;
 return dx * GRASS_GRADIENTS[h] + dy * GRASS_GRADIENTS[h | 1];
}
float grass_noise_simplex(int seed, float x, float y )
    {
        // 2D OpenSimplex2S case is a modified 2D simplex noise.

        const float SQRT3 = 1.7320508075688772935274463415059;
        const float G2 = (3.0 - SQRT3) / 6.0;

        /*
         * --- Skew moved to TransformNoiseCoordinate method ---
         * const float F2 = 0.5 * (SQRT3 - 1.0);
         * float s = (x + y) * F2;
         * x += s; y += s;
        */

        int i = grass_noise_floor(x);
        int j = grass_noise_floor(y);
        float xi = x - float(i);
        float yi = y - float(j);

        i *= GRASS_PRIME_X;
        j *= GRASS_PRIME_Y;
        int i1 = i + GRASS_PRIME_X;
        int j1 = j + GRASS_PRIME_Y;

        float t = (xi + yi) * G2;
        float x0 = xi - t;
        float y0 = yi - t;

        float a0 = (2.0 / 3.0) - x0 * x0 - y0 * y0;
        float value = (a0 * a0) * (a0 * a0) * grass_noise_grad(seed, i, j, x0, y0);

        float a1 = (2.0 * (1.0 - 2.0 * G2) * (1.0 / G2 - 2.0)) * t + ((-2.0 * (1.0 - 2.0 * G2) * (1.0 - 2.0 * G2)) + a0);
        float x1 = x0 - (1.0 - 2.0 * G2);
        float y1 = y0 - (1.0 - 2.0 * G2);
        value += (a1 * a1) * (a1 * a1) * grass_noise_grad(seed, i1, j1, x1, y1);

        // Nested conditionals were faster than compact bit logic/arithmetic.
        float xmyi = xi - yi;
        if (t > G2)
        {
            if (xi + xmyi > 1.0)
            {
                float x2 = x0 + (3.0 * G2 - 2.0);
                float y2 = y0 + (3.0 * G2 - 1.0);
                float a2 = (2.0 / 3.0) - x2 * x2 - y2 * y2;
                if (a2 > 0.0)
                {
                    value += (a2 * a2) * (a2 * a2) * grass_noise_grad(seed, i + (GRASS_PRIME_X << 1), j + GRASS_PRIME_Y, x2, y2);
                }
            }
            else
            {
                float x2 = x0 + G2;
                float y2 = y0 + (G2 - 1.0);
                float a2 = (2.0 / 3.0) - x2 * x2 - y2 * y2;
                if (a2 > 0.0)
                {
                    value += (a2 * a2) * (a2 * a2) * grass_noise_grad(seed, i, j + GRASS_PRIME_Y, x2, y2);
                }
            }

            if (yi - xmyi > 1.0)
            {
                float x3 = x0 + (3.0 * G2 - 1.0);
                float y3 = y0 + (3.0 * G2 - 2.0);
                float a3 = (2.0 / 3.0) - x3 * x3 - y3 * y3;
                if (a3 > 0.0)
                {
                    value += (a3 * a3) * (a3 * a3) * grass_noise_grad(seed, i + GRASS_PRIME_X, j + (GRASS_PRIME_Y << 1), x3, y3);
                }
            }
            else
            {
                float x3 = x0 + (G2 - 1.0);
                float y3 = y0 + G2;
                float a3 = (2.0 / 3.0) - x3 * x3 - y3 * y3;
                if (a3 > 0.0)
                {
                    value += (a3 * a3) * (a3 * a3) * grass_noise_grad(seed, i + GRASS_PRIME_X, j, x3, y3);
                }
            }
        }
        else
        {
            if (xi + xmyi < 0.0)
            {
                float x2 = x0 + (1.0 - G2);
                float y2 = y0 - G2;
                float a2 = (2.0 / 3.0) - x2 * x2 - y2 * y2;
                if (a2 > 0.0)
                {
                    value += (a2 * a2) * (a2 * a2) * grass_noise_grad(seed, i - GRASS_PRIME_X, j, x2, y2);
                }
            }
            else
            {
                float x2 = x0 + (G2 - 1.0);
                float y2 = y0 + G2;
                float a2 = (2.0 / 3.0) - x2 * x2 - y2 * y2;
                if (a2 > 0.0)
                {
                    value += (a2 * a2) * (a2 * a2) * grass_noise_grad(seed, i + GRASS_PRIME_X, j, x2, y2);
                }
            }

            if (yi < xmyi)
            {
                float x2 = x0 - G2;
                float y2 = y0 - (G2 - 1.0);
                float a2 = (2.0 / 3.0) - x2 * x2 - y2 * y2;
                if (a2 > 0.0)
                {
                    value += (a2 * a2) * (a2 * a2) * grass_noise_grad(seed, i, j - GRASS_PRIME_Y, x2, y2);
                }
            }
            else
            {
                float x2 = x0 + G2;
                float y2 = y0 + (G2 - 1.0);
                float a2 = (2.0 / 3.0) - x2 * x2 - y2 * y2;
                if (a2 > 0.0)
                {
                    value += (a2 * a2) * (a2 * a2) * grass_noise_grad(seed, i, j + GRASS_PRIME_Y, x2, y2);
                }
            }
        }

        return value * 18.24196194486065;
    }
