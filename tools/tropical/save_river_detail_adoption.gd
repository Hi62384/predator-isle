extends SceneTree
func _initialize()->void:
	var hashes:Dictionary={};var images:Dictionary={};var records:Dictionary={}
	for name:String in ["check_river_detail","render_river_detail"]:
		var path:String="res://tools/tropical/artifacts/"+name+".json";var report=JSON.parse_string(FileAccess.get_file_as_string(path));assert(report.passed and report.failures.is_empty());hashes[path]=FileAccess.get_sha256(path)
		for source:String in report.source_sha256:assert(FileAccess.get_sha256(source)==report.source_sha256[source],"Stale river evidence "+source);hashes[source]=report.source_sha256[source]
		for image:String in report.get("capture_sha256",{}):assert(FileAccess.get_sha256(image)==report.capture_sha256[image]);images[image]=report.capture_sha256[image]
		records[name]=report
	assert(images.size()==18 and records.render_river_detail.phases.size()==9)
	for phase:Dictionary in records.render_river_detail.phases:
		if int(phase.phase)==1:assert(phase.actual_resolution==64 and phase.refined_lod4_leaves>0)
		elif int(phase.phase)==2:assert(phase.reference_return_exact)
	var regression=JSON.parse_string(FileAccess.get_file_as_string("res://data/surface_regression_20261018.json"));assert(regression.passed and regression.test_count==31)
	for source:String in ["res://tools/tropical/save_river_detail_adoption.gd","res://data/surface_regression_20261018.json"]:hashes[source]=FileAccess.get_sha256(source)
	var report:Dictionary={"passed":true,"failures":[],"production_registration":true,"all_user_tasks_complete":false,"surface_reference_quality_complete":false,"cave_biomes_implemented":false,"completed_utc":Time.get_datetime_string_from_system(true),"source_sha256":hashes,"capture_sha256":images,"numeric":records.check_river_detail.summary,"assertions":records.check_river_detail.assertions,"native_phases":records.render_river_detail.phases,"scope":"Pure Tropical main-carrier refinement bounded toLOD2–4 and128 grid resolution, default32m. Independent zero mode; canonical heights/water/ownership unchanged. Nine numerical sites/three seeds,LOD3/4 common vertices and sparse/dense normal precision,18 actual native views with fixed separate spectator target, complete per-leaf original/reference-return arrays,actualLOD3 andLOD4 worker payloads,and31 shared regressions. More mesh work is intentional; ordered non-isolated phase timings are not a gain or a general performance certificate. No full distant/tributary/material/art acceptance, no cave implementation.","shader_history":"Earlier conservative single-extension renderer remains registered; its separate hash-specific checkpoint is experiment_terrain_shader_variant_adoption_e32e70a10df7. The later rejected origin-parity correction is archived under failed_diagnostic_origin_phase_resource_failure_4acd7f12d2d7; original production shaders remain restored, and the old mycelium seam is not repaired by this river change."}
	report["default_spacing_metres"]={"lod2":32,"lod3":32,"lod4":64}
	report["scope"]="Pure Tropical main-carrier refinement bounded toLOD2–4 and128 resolution. Default32m atLOD2/3,64m atLOD4; independent zero. Canonical heights/water/ownership unchanged. Nine numerical sites/three seeds,parent continuity/normal precision,18 actual streamed views with actualLOD3/4 densities and complete original/reference-return arrays,and31 shared regressions. More mesh work is intentional. Ordered non-isolated times are not a performance gain. The preceding uniform32m outer revision is preserved as experiment_tropical_river_detail_adoption_8fca77023d2e. No distant/tributary/art/cave completion."
	report["rejected_cache_trial"]="failed_diagnostic_dense_river_cache_trial_4ee1a2d0a44b preserves8 copies. Larger memo retained17161 nodes but both versions performed51483 raw evaluations across the three cold dense builds; no work reduction. Original sampler/builder cache implementation restored exactly."
	for target:String in ["res://data/tropical_river_detail_adoption.json","res://tools/biome_extensions/artifacts/tropical_river_detail_adoption.json"]:FileAccess.open(target,FileAccess.WRITE).store_string(JSON.stringify(report,"  "))
	print("TROPICAL_RIVER_ADOPTION_SAVED ",hashes.size()," guards / ",images.size()," images");quit()
