func _initialize()->void:call_deferred("prepare")
func prepare()->void:
	var code:String=FileAccess.get_file_as_string("res://tools/biome_extensions/check_ground_union_worker_walk.gd")
	code=code.replace('const INPUT="res://tools/biome_extensions/artifacts/diagnose_tissue_ground_boundary.json"','const INPUT="res://tools/biome_extensions/artifacts/admit_ground_union_additional_site.json"')
	var admission:String="assert(diagnostic.passed and diagnostic.cpu_gpu_source_matches==9);var focus:Vector3=v3(diagnostic.focus)";assert(code.count(admission)==1)
	code=code.replace(admission,'assert(diagnostic.passed and diagnostic.site.seed==92881);var focus:=Vector3(diagnostic.site.point[0],diagnostic.site.canonical_height+2,diagnostic.site.point[2])')
	code=code.replace(".builder(17,true)",".builder(92881,true)").replace("terrain.world_seed=17","terrain.world_seed=92881")
	code=code.replace("range(17)","range(13)").replace("-80+station*10","-30+station*5").replace("points.size()==17","points.size()==13").replace("points.size()!=17","points.size()!=13")
	var route:String='''for index in range(1,points.size()):route.append(points[index])
		for index in range(points.size()-2,-1,-1):route.append(points[index])''';assert(code.count(route)==1)
	code=code.replace(route,'''for index in range(7,13):route.append(points[index])
		for index in range(11,-1,-1):route.append(points[index])
		for index in range(1,7):route.append(points[index])''').replace("points[0]","points[6]")
	var floor_marker:String="points.append(hit.position+Vector3(0,.95,0));";assert(code.count(floor_marker)==1)
	code=code.replace(floor_marker,'check(hit.normal.y>=cos(deg_to_rad(45)),"Every declared local route sample respects original45degree floor grade");'+floor_marker)
	var guard:String="var reference_heights:Array=[]";assert(code.count(guard)==1);code=code.replace(guard,'guards["res://tools/biome_extensions/check_ground_union_local_walk.gd"]=FileAccess.get_sha256("res://tools/biome_extensions/check_ground_union_local_walk.gd")\n\t'+guard)
	code=code.replace("check_ground_union_worker_walk.json","check_ground_union_local_walk.json").replace("Actual320m shoulder","Actual120m local shoulder")
	code=code.replace('"scope":"PRIVATE actual','"scope":"ADDITIONAL LOCAL trial at the previously frozen changed92881 shoulder,centre-to+30m/across-to-30m/back-to-centre,120m actual route. Does NOT replace or repair the separately preserved failed80m long approach or original weak-intervention efficacy gate. Initial position is on the geometry-admitted original/candidate central floor;all13 fixed5m floor samples must respect the SAME45degree limit before movement. No limits reset after spawn. PRIVATE actual')
	code=code.replace("at EXACT seed17 ground-boundary cross-section","at the frozen additional92881 shoulder").replace("17 fixed native floor probes","13 fixed native floor probes").replace("Two320m capsule returns","Two120m local capsule returns")
	var script:=GDScript.new();script.source_code=code;assert(script.reload()==OK);set_script(script);call_deferred("run")
