extends SceneTree
func _initialize()->void:
	var second:bool=OS.get_cmdline_user_args().has("second")
	var hashes:Dictionary={}
	for path:String in ["res://scenes/main.tscn","res://config/world/terrain_settings.tres","res://scripts/chunk_terrain.gd","res://scripts/terrain_mesh_builder.gd","res://shaders/terrain_biomes.gdshader","res://shaders/biological_sampling.gdshaderinc","res://tools/biome_extensions/run_test.ps1","res://tools/biome_extensions/render_all.gd","res://tools/biome_extensions/render_alien_memory_baseline.gd","res://tools/biome_extensions/render_pure_alien_shader_candidate.gd","res://tools/biome_extensions/bootstrap_pure_alien_shader_candidate.gd","res://tools/biome_extensions/render_preloaded_pure_alien_candidate.gd","res://tools/biome_extensions/pure_alien_fragment_candidate.gdshaderinc","res://tools/biome_extensions/record_shader_domain_failure.gd","res://.godot/extensions_bootstrap_pure_alien_shader_candidate.engine.log","res://.godot/extensions_bootstrap_pure_alien_shader_candidate.out.log","res://.godot/extensions_bootstrap_pure_alien_shader_candidate.err.log"]:hashes[path]=FileAccess.get_sha256(path)
	assert(FileAccess.get_file_as_string("res://.godot/extensions_bootstrap_pure_alien_shader_candidate.engine.log").contains("Specialization must not silently shade mixed/empty tiles" if second else "Every owner sample must have full Alien coverage"))
	FileAccess.open("res://tools/biome_extensions/artifacts/render_preloaded_pure_alien_rejected_domain"+("_v2" if second else "")+".json",FileAccess.WRITE).store_string(JSON.stringify({"passed":false,"failures":["Early resource registration reached actual streamed-tile validation, but a tile failed the strict pure-owner predicate (partial coverage or mixed/empty atlas). No full-view/pixel-equivalence or memory-success certificate."],"source_sha256":hashes,"production_registration":false,"scope":"Forensic exact source/log preservation of the rejected private specialization. Reaching the domain guard before the external cap stopped this process is not a completed memory test. The strict domain guard must not be loosened to claim success."},"  "))
	quit()
