extends SceneTree
func _initialize()->void:
	var guards:Dictionary={};var images:Dictionary={};var counts:Dictionary={};var native:Dictionary={};var worker:Dictionary={}
	for name:String in ["check_crystal_bulk_registration","check_crystal_bulk_gpu_registered","render_crystal_bulk_registered","profile_crystal_bulk_worker"]:
		var path:String="res://tools/biome_extensions/artifacts/"+name+".json";var report=JSON.parse_string(FileAccess.get_file_as_string(path));assert(report.passed and report.failures.is_empty());guards[path]=FileAccess.get_sha256(path)
