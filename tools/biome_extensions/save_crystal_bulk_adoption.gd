		for capture:String in report.get("capture_sha256",{}):assert(FileAccess.get_sha256(capture)==report.capture_sha256[capture]);images[capture]=report.capture_sha256[capture]
		counts[name]=report.get("checks",null)
		if name=="render_crystal_bulk_registered":native=report
		if name=="profile_crystal_bulk_worker":worker=report
	assert(images.size()==55 and native.views.size()==54 and native.phases.size()==36 and worker.cases.size()==9)
	var regression_path:String="res://data/surface_regression_20261018.json";var regression=JSON.parse_string(FileAccess.get_file_as_string(regression_path));assert(regression.passed and regression.test_count==31);guards[regression_path]=FileAccess.get_sha256(regression_path)
	for raw:String in regression.source_sha256:
		var path:String="res://"+raw.replace("\\","/");assert(FileAccess.get_sha256(path)==regression.source_sha256[raw]);guards[path]=regression.source_sha256[raw]
	var history_path:String="res://tools/biome_extensions/artifacts/revisions/experiment_crystal_bulk_trial_68828270bd88/manifest.json";var history=JSON.parse_string(FileAccess.get_file_as_string(history_path));guards[history_path]=FileAccess.get_sha256(history_path)
	for copy:Dictionary in history.files:assert(FileAccess.get_sha256(copy.snapshot)==copy.sha256)
	var gpu:Array=[]
	for view:String in ["ground","medium"]:
		var sum:Dictionary={false:0.0,true:0.0};var samples:Dictionary={false:0,true:0}
		for record:Dictionary in native.views:
			if record.view!=view:continue
			assert(record.gpu_p50_ms!=null);sum[record.enabled]+=record.gpu_p50_ms;samples[record.enabled]+=1
		gpu.append({"view":view,"off_mean_block_median_ms":sum[false]/samples[false],"on_mean_block_median_ms":sum[true]/samples[true],"off_blocks":samples[false],"on_blocks":samples[true]})
	guards["res://tools/biome_extensions/save_crystal_bulk_adoption.gd"]=FileAccess.get_sha256("res://tools/biome_extensions/save_crystal_bulk_adoption.gd")
	var result:Dictionary={"passed":true,"failures":[],"production_registration":true,"completed_utc":Time.get_datetime_string_from_system(true),"source_sha256":guards,"capture_sha256":images,"checks_by_report":counts,"shared_regression_tests":31,"configured_native_images":54,"configured_cuts":36,"gpu_summary":gpu,"median_nonisolated_cold_worker_on_off_ratio":worker.median_on_off_ratio,"historical_private_manifest":history_path,"historical_private_verified_copies":history.files.size(),"all_user_tasks_complete":false,"surface_reference_quality_complete":false,"caves_implemented":false,"scope":"REGISTERED independent default-on crystal_bulk_material binds actual prism minimum cross-section/mineral/growth metadata and six-family thickness-aware material. Large masses mostly opaque;thin blades/smaller minerals retain bounded filtered transmission,IOR/Fresnel,growth zoning and true depth writes. False restores prior complete UV arrays AND original shader;foundation control remains independent. Actual vertices/normals/colors/collision/terrain/water/ownership unchanged;no new triangles,texture or atlas. Exact frozen accepted shader/formula,140registration checks,101035GPU/metadata checks including49152independent absorption samples,36actual configured four-worker cuts/54images covering all original geographic views plus separately pre-admitted six-habit positives,nine actual cold-worker payload/cost pairs and31shared regressions pass.","limitations":"Authored Beer-Lambert/screen refraction approximation,not measured PBR scans or physically ray-traced internal thickness/refraction ordering. Whole-biome reference art,streaming/cold-start costs and ordered cave phases remain unfinished. Native original/off/on cuts are separate cold scenes:array returns exact,pixel differences reported not certified exact. Frozen accepted private study separately has18strict same-scene image returns. Visible water usesTIME0 only in private duplicates to isolate image comparisons;production animation/lighting unchanged. Initial live-time original-return failure and failed9x9 smoky-root admission are preserved;separate33x33 root discovery was frozen before positive views. All GPU/CPU timing is NON-ISOLATED;presentation remains about16.67ms. Added GPU material cost,not a speedup or universal frame guarantee. The user's separate open Godot process was never stopped.","external_watch_observations_transcribed":{"native_peak_mib":1055.4,"native_limit_mib":4096,"gpu_reference_peak_mib":313.5,"gpu_reference_limit_mib":1536,"worker_peak_mib":84.8,"worker_limit_mib":1024,"registration_peak_mib":84.0,"sample_period_ms":500,"machine_exclusive":false}}
	for path:String in ["res://data/crystal_bulk_adoption.json","res://tools/biome_extensions/artifacts/crystal_bulk_adoption.json"]:FileAccess.open(path,FileAccess.WRITE).store_string(JSON.stringify(result,"  "))
	print("CRYSTAL_BULK_ADOPTED ",guards.size()," guards / ",images.size()," images / GPU ",gpu);quit()
