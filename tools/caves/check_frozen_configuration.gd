extends "res://tools/caves/check_frozen_features.gd"
const SurfaceMaterials=preload("res://scripts/caves/biome_materials.gd")
func run()->void:
	var guards:Dictionary=FrozenFixture.guards()
	for name:String in DirAccess.get_files_at("res://scripts/caves"):
		if name.ends_with(".gd"):var path:String="res://scripts/caves/"+name;guards[path]=FileAccess.get_sha256(path)
	for path:String in [get_script().resource_path,"res://tools/caves/check_frozen_features.gd","res://config/caves/biomes/frozen_cave_definition.tres"]:guards[path]=FileAccess.get_sha256(path)
	var definition:Resource=load("res://config/caves/biomes/frozen_cave_definition.tres").duplicate_deep(Resource.DEEP_DUPLICATE_ALL);check(definition.validation_errors().is_empty(),"Provider contracts and all normal Frozen numeric ranges valid")
	for table:String in ["material_configuration","feature_configuration"]:
		for setting:String in (["texture_metres","normal_strength"] if table=="material_configuration" else ["density","curtain_chance","lake_radius_multiplier","lake_radius_minimum","lake_radius_maximum"]):
			var candidate:Resource=definition.duplicate_deep(Resource.DEEP_DUPLICATE_ALL);candidate.get(table)[setting]=NAN;check(not candidate.validation_errors().is_empty(),"NaN Frozen control rejected before worker or shader "+setting)
	var wrong:Resource=definition.duplicate_deep(Resource.DEEP_DUPLICATE_ALL);wrong.feature_configuration.lake_radius_minimum=12;wrong.feature_configuration.lake_radius_maximum=8;check(not wrong.validation_errors().is_empty(),"Reversed physical lake sizes rejected")
	wrong=definition.duplicate_deep(Resource.DEEP_DUPLICATE_ALL);wrong.feature_configuration.lake_ice="yes";check(not wrong.validation_errors().is_empty(),"Non-boolean geometry switch rejected")
	var height:Callable=func(_x:float,_z:float)->float:return 150.0
	var region:Dictionary=fixture();var original:PackedByteArray=var_to_bytes(region);var generator=Features.new();var expanded:Dictionary=generator.decorate_region(region,height,73921,definition.feature_configuration,400,10)
	check(var_to_bytes(region)==original,"Regional frozen lake admission never mutates original Default dictionary/arrays")
	check(expanded.pools[0].get("frozen_lake",false) and expanded.pools[0].radius>=8 and expanded.pools[0].bed.chamber_height==expanded.pools[0].depth+8,"Positive enlarged actual retained basin with safe air volume,not random new water")
	check(Basins.route_clear(expanded.pools[0].center,expanded.pools[0].radius,expanded.pools[0].bed_y,expanded.pools[0].water_y,expanded),"Large lake retains all original protected dry routes")
	check(var_to_bytes(expanded)==var_to_bytes(generator.decorate_region(region,height,73921,definition.feature_configuration,400,10)),"Complete enlarged basin repeat deterministic")
	var disabled:Dictionary=definition.feature_configuration.duplicate();disabled.large_lakes=false;check(var_to_bytes(generator.decorate_region(region,height,73921,disabled,400,10))==original,"Independent large-lake-off gives complete original region exactly")
	var default_region:Dictionary=region.duplicate(true);default_region.erase("cave_biome_regions");check(var_to_bytes(generator.decorate_region(default_region,height,73921,definition.feature_configuration,400,10))==var_to_bytes(default_region),"Default/unassigned rooms retain exact original small retained-water geography")
	var low_roof:Callable=func(_x:float,_z:float)->float:return 35.0
	check(var_to_bytes(generator.decorate_region(region,low_roof,73921,definition.feature_configuration,400,10))==original,"Insufficient surface rock cover rejects large basin without clipping a partial unsafe room")
	var protected_region:Dictionary=region.duplicate(true);protected_region.edges.append({"from":"guard","to":"guard","points":PackedVector3Array([Vector3(37,20,45),Vector3(37,20,55)]),"half_width":4.0,"headroom":8.0,"entrance":false});check(var_to_bytes(generator.decorate_region(protected_region,height,73921,definition.feature_configuration,400,10))==var_to_bytes(protected_region),"Nearby real protected passage rejects lake expansion without favorable movement reroute")
	var field=Field.new();field.include_surface_air=false;check(field.compile([expanded],height,[],expanded.cave_biome_regions),"Large frozen basin compiles in same constrained sparse field")
	var water:Dictionary=Basins.water_cell([expanded],field,Vector3i.ZERO);check(not water.arrays.is_empty() and water.rejected.is_empty(),"Large retained lake uses actual bounded shoreline/stream triangulation")
	var payload:Dictionary=generator.build(field,Vector3i.ZERO,73921,[expanded],definition.feature_configuration,water);var apron:bool=false
	for placement:Dictionary in payload.placements:
		if placement.kind=="ice_shore_apron":apron=true;check(placement.maximum_grade<=.2 and placement.width_minimum>=3.5 and placement.thickness==.55,"Solid naturally graded safe shore deposit retains walking width/grade")
	check(payload.valid and apron,"Large physical frozen lake retains positive solid shore connection")
	var config=Config.new();config.biome_regions=config.biome_regions.duplicate_deep(Resource.DEEP_DUPLICATE_ALL);config.biome_regions=FrozenFixture.registry(config.biome_regions,definition);var base:Shader=load("res://shaders/default_cave_rock.gdshader");var first:Shader=SurfaceMaterials.shader(base,["frozen"],config.biome_regions);check(first!=null and first==SurfaceMaterials.shader(base,["frozen"],config.biome_regions),"Same validated provider code reuses bounded material shader")
	var alternative:=GDScript.new();alternative.source_code=definition.surface_provider.source_code.replace("float frozen_crust=(.12+","float frozen_crust=(.13+");check(alternative.reload()==OK,"Independent private provider source counterfactual compiles");var alternate_definition:Resource=definition.duplicate_deep(Resource.DEEP_DUPLICATE_ALL);alternate_definition.surface_provider=alternative;var alternate_config:Resource=config.biome_regions.duplicate_deep(Resource.DEEP_DUPLICATE_ALL);alternate_config.definitions[-1]=alternate_definition;var alternate_shader:Shader=SurfaceMaterials.shader(base,["frozen"],alternate_config);check(alternate_shader!=first and alternate_shader.code!=first.code,"Different adapter source under same stable biome ID never reuses stale generated shader")
	check(SurfaceMaterials.shader(base,["not_registered"],config.biome_regions)==null,"Missing biome adapter fails closed instead of a white/null-shader cave")
	for path:String in guards:check(FileAccess.get_sha256(path)==guards[path],"Stable Frozen regional/material configuration "+path)
	FileAccess.open("res://tools/biome_extensions/artifacts/check_cave_frozen_configuration.json",FileAccess.WRITE).store_string(JSON.stringify({"passed":failures.is_empty(),"checks":checks,"failures":failures,"source_sha256":guards,"original_radius":region.pools[0].radius,"large_radius":expanded.pools[0].radius,"scope":"Validated provider contract/finite settings,source-sensitive bounded shader cache,independent positive large retained lake/negative Default/off/roof/protected-route controls,same sparse volume and real bounded water/shore geometry. Not native large-lake walk,rendered art,world streaming or complete Frozen acceptance."},"  "));print("FROZEN_CONFIGURATION ",checks," radius=",expanded.pools[0].radius," failures=",failures);quit(0 if failures.is_empty() else 1)
