	var roundtrip_path:String="res://.godot/crystal_registered_roundtrip.tres";check(ResourceSaver.save(configuration.biome_regions,roundtrip_path)==OK,"Actual editable three-biome Resource roundtrip saves");var roundtrip:Resource=ResourceLoader.load(roundtrip_path,"",ResourceLoader.CACHE_MODE_IGNORE)
