extends "res://tools/biome_extensions/check_all.gd"
func guard_report(path:String,guards:Dictionary)->Dictionary:
	var result:Dictionary=JSON.parse_string(FileAccess.get_file_as_string(path));check(result.get("passed",false),"Passed original report "+path);guards[path]=FileAccess.get_sha256(path)
	for source:String in result.source_sha256:
		check(FileAccess.get_sha256(source)==result.source_sha256[source],"Current exact original source "+source);guards[source]=result.source_sha256[source]
	for capture:String in result.get("capture_sha256",{}):check(FileAccess.get_sha256(capture)==result.capture_sha256[capture],"Original native pixels retained "+capture);guards[capture]=result.capture_sha256[capture]
	return result
func run()->void:
	var guards:Dictionary={get_script().resource_path:FileAccess.get_sha256(get_script().resource_path)};var plan_path:String="res://tools/biome_extensions/artifacts/magma_source_seed_cohort_plan.json";var plan:Dictionary=JSON.parse_string(FileAccess.get_file_as_string(plan_path));guards[plan_path]=FileAccess.get_sha256(plan_path);check(PackedInt32Array(plan.seeds)==PackedInt32Array([17,92881,1000,1001,1002,19]) and plan.grid_min== -48 and plan.grid_max==48,"Original six-seed/grid/order plan unchanged")
	var records:Array=[];var sources:int=0;var sites:int=0;var hot:int=0;var molten:int=0;var first:Dictionary={};var kinds:Dictionary={}
	for seed_value in plan.seeds:
		var seed_id:int=int(seed_value);var path:String="res://tools/biome_extensions/artifacts/check_cave_magma_intrusive_source_index_"+str(seed_id)+".json";var survey:Dictionary=guard_report(path,guards);check(int(survey.seed)==seed_id and survey.includes_explicit_intrusive_bodies,"Exact declared normal source-model seed "+str(seed_id));sources+=survey.sources.size();sites+=survey.rows.size();hot+=int(survey.thermal_source_count);molten+=int(survey.molten_pool_count)
		for source:Dictionary in survey.sources:kinds[str(source.kind)]=int(kinds.get(str(source.kind),0))+1
		if first.is_empty() and not survey.first_molten.is_empty():first={"seed":seed_id,"row":survey.first_molten}
		records.append({"seed":seed_id,"report":path,"sha256":FileAccess.get_sha256(path),"source_count":survey.sources.size(),"case_count":survey.rows.size(),"molten_pool_count":survey.molten_pool_count})
	check(not first.is_empty() and first.seed==17,"First positive selected in declared seed order,not completion order")
	var native:Dictionary=guard_report("res://tools/biome_extensions/artifacts/render_cave_magma_intrusive_world.json",guards);check(int(native.seed)==17 and native.site==first.row.site and str(native.pool.id)==str(first.row.molten_pools[0].id) and native.molten_vertices>0,"Native positive is exact original FIRST admitted molten pool")
	for walk:Dictionary in native.walks:check(walk.finished and not walk.failed and walk.waypoint==walk.waypoints and walk.maximum_unsupported_drop_m<.75,"Original ordinary native molten-room return complete")
	var blend:Dictionary=guard_report("res://tools/biome_extensions/artifacts/check_cave_magma_blend_gpu.json",guards)
	for row:Dictionary in blend.records:check(row.rgb_error<=2 and row.reverse_rgb_error<=2,"Actual three-provider partial material oracle within declared bound")
	for prefix:String in ["magma_source_seed_17","magma_source_seed_92881","magma_source_seed_1000","magma_source_seed_1001","magma_source_seed_1002","magma_source_seed_19","magma_intrusive_native_crust","magma_blend_gpu"]:
		var receipt_path:String="res://.godot/extensions_"+prefix+".receipt.json";var receipt:Dictionary=JSON.parse_string(FileAccess.get_file_as_string(receipt_path));check(receipt.passed and int(receipt.exit_code)==0 and int(receipt.memory_limit_mib)==2048 and receipt.sampled_peak_private_bytes!=null and float(receipt.sampled_peak_private_bytes)<2048*1048576,"Owned native receipt under declared memory bound "+prefix)
		for suffix:String in [".receipt.json",".out.log",".err.log",".engine.log"]:
			var path:String="res://.godot/extensions_"+prefix+suffix;check(FileAccess.file_exists(path),"Native receipt/log retained "+path);guards[path]=FileAccess.get_sha256(path)
	check(load("res://config/caves/cave_biome_regions.tres").definitions.size()==3 and not load("res://config/caves/cave_settings.tres").enabled,"Saved registry/root remain unchanged pending remaining Magma/global gates")
	FileAccess.open("res://tools/biome_extensions/artifacts/check_cave_magma_source_cohort.json",FileAccess.WRITE).store_string(JSON.stringify({"passed":failures.is_empty(),"checks":checks,"failures":failures,"source_sha256":guards,"records":records,"source_count":sources,"case_count":sites,"localized_heat_records":hot,"molten_pool_count":molten,"source_kinds":kinds,"first":first,"native_walks":native.walks,"native_molten_vertices":native.molten_vertices,"reference_art_acceptance":false,"all_user_completion":false,"scope":"Complete predeclared six-seed97x97 source grids and every unique3x3 cave neighbour,all negatives retained/current numeric sources unchanged. Exact first normal source-backed molten pool actual native pixels/material/ordinary localized return plus independent three-provider partial Albedo composition;receipts and logs retained. Targeted source inventory,not global prevalence or physical thermal simulation. Full live Magma route,large-lake/cathedral/scenic breadth,global art/startup/performance/root activation still open."},"  "));print("MAGMA_SOURCE_COHORT ",checks," sources=",sources," sites=",sites," molten=",molten," failures=",failures);quit(0 if failures.is_empty() else 1)
