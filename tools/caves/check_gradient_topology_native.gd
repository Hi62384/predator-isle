extends SceneTree
func _initialize()->void:
	var original:String="res://tools/caves/check_actual_graph_native.gd";var paired_path:String="res://tools/biome_extensions/artifacts/profile_cave_gradient_mesher.json";var source:String=FileAccess.get_file_as_string(original)
	source=source.replace('const Mesher=preload("res://tools/caves/cave_mesher_candidate.gd")','const Mesher=preload("res://tools/caves/cave_gradient_mesher_candidate.gd")\nconst Topology=preload("res://tools/caves/cave_mesh_topology_candidate.gd")')
	var marker:String='var bodies:Array=[];';assert(source.count(marker)==1)
	source=source.replace(marker,'''var topology=Topology.new();topology.selected=keys;var expected=JSON.parse_string(FileAccess.get_file_as_string("'''+paired_path+'''"));assert(not expected.passed and expected.paired_chunks.size()==227);var expected_hashes:Dictionary={}
	for record:Dictionary in expected.paired_chunks:expected_hashes[record.key]=record.candidate_complete_arrays_sha256
	'''+marker)
	var mesh:String='var arrays:Array=Mesher.new().build(field,key,2);';assert(source.count(mesh)==1)
	source=source.replace(mesh,mesh+'''var hash:=HashingContext.new();hash.start(HashingContext.HASH_SHA256);hash.update(var_to_bytes(arrays));check(expected_hashes.get(str(key),"")==hash.finish().hex_encode(),"Complete repaired candidate mesh repeats original failed-equivalence candidate output exactly");topology.add(arrays,key);''')
	var physics:String='for frame in range(3):await physics_frame';assert(source.count(physics)==1)
	source=source.replace(physics,'''var audit:Dictionary=topology.result();check(audit.same_direction_pairs==0 and audit.interior_open_edges==0 and audit.nonmanifold_edges==0,"EVERY actual internal global edge has exactly two oppositely directed triangle incidences");check(audit.paired_edges>100000,"Large positive actual topology,not empty edge sets");print("ACTUAL_GLOBAL_TOPOLOGY ",audit);topology.edges.clear()
	var omitted=Topology.new();omitted.selected={Vector3i.ZERO:true};var broken:Array=[];broken.resize(Mesh.ARRAY_MAX);broken[Mesh.ARRAY_VERTEX]=PackedVector3Array([Vector3(20,20,20),Vector3(21,20,20),Vector3(20,21,20)]);omitted.add(broken,Vector3i.ZERO);check(omitted.result().interior_open_edges==3,"A genuinely isolated interior triangle exposes three exact detected open edges")
	'''+physics)
	source=source.replace('"largest_single_chunk_mesh_seconds":largest_chunk_seconds','"largest_single_chunk_mesh_seconds":largest_chunk_seconds,"global_oriented_topology":audit')
	source=source.replace('res://tools/caves/check_actual_graph_native.gd','res://tools/caves/check_gradient_topology_native.gd').replace('check_cave_actual_graph_native.json','check_cave_gradient_topology_native.json')
	var guard:String='var guards:Dictionary={}';assert(source.count(guard)==1);source=source.replace(guard,guard+';guards["'+original+'"]=FileAccess.get_sha256("'+original+'");guards["'+paired_path+'"]=FileAccess.get_sha256("'+paired_path+'");guards["res://tools/caves/cave_gradient_mesher_candidate.gd"]=FileAccess.get_sha256("res://tools/caves/cave_gradient_mesher_candidate.gd");guards["res://tools/caves/cave_mesh_topology_candidate.gd"]=FileAccess.get_sha256("res://tools/caves/cave_mesh_topology_candidate.gd")')
	source=source.replace('PRIVATE original actual canonical Spore surface geographic cell,Default-only17node/20edge3D implicit union.','PRIVATE repaired original actual Spore graph: tetrahedral linear-gradient face orientation is an INTENTIONAL winding repair,not bit-equivalent to centroid-normal orientation. All227candidate full arrays must repeat the separately preserved failed-equivalence candidate hashes. Global exact incidence AND opposite direction audited over all emitted original route cells;only explicit selected-chunk-set external boundaries may remain single. Isolated-triangle negative detects all3open edges. Default-only17node/20edge3D implicit union. Prebuild timing includes topology/hash instrumentation,not isolated mesh/runtime speed.')
	var script:=GDScript.new();script.source_code=source;assert(script.reload()==OK);set_script(script);call_deferred("run")
