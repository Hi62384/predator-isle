extends "res://tools/biome_extensions/check_all.gd"
const Scope=preload("res://tools/caves/inspection_scope.gd")
func run()->void:
	var source_path:String="res://tools/caves/inspection_scope.gd";var sha:String=FileAccess.get_sha256(source_path);var guards:Dictionary={source_path:sha};Scope.capture_terrain_dependencies(guards)
	check(guards.has("res://scripts/terrain_mesh_builder.gd") and guards.has("res://config/world/terrain_settings.tres") and guards.has("res://project.godot"),"Canonical terrain sampler and actual saved configuration are guarded even in underground inspection")
	check(not Scope.is_dependency("res://shaders/blob_membrane.gdshader") and Scope.is_dependency("res://shaders/biological_sampling.gdshaderinc") and Scope.is_dependency("res://shaders/cave_crystal_feature.gdshader"),"Only unrelated named character shaders excluded;biological terrain and cave dependencies retained")
	check(Scope.dependency_closure_valid(guards),"Actual canonical terrain dependency closure has no excluded character shader")
	var poisoned:=GDScript.new();poisoned.source_code=FileAccess.get_file_as_string(source_path).replace("var source:String=FileAccess.get_file_as_string(path)","var source:String=\"res://shaders/blob_membrane.gdshader\"");check(poisoned.reload()==OK and not poisoned.dependency_closure_valid({"res://scripts/caves/field.gd":"test"}),"An excluded character shader referenced by a cave dependency is rejected")
	var scene:=Node3D.new();var environment:=WorldEnvironment.new();environment.name="WorldEnvironment";scene.add_child(environment);var sun:=DirectionalLight3D.new();sun.name="Sun";scene.add_child(sun);var camera:=Camera3D.new();camera.name="FreeCamera";camera.far=50000;scene.add_child(camera);var workshop:=Node3D.new();workshop.name="BlobWorkshop";var script:=GDScript.new();script.source_code="extends Node3D\nfunc _ready()->void:get_parent().set_meta(\"workshop_ready\",true)\n";check(script.reload()==OK,"Controlled workshop ready callback compiles");workshop.set_script(script);scene.add_child(workshop)
	check(Scope.isolate_environment(scene),"Unrelated workshop detached from inspection instance before ready");root.add_child(scene);await process_frame;check(not scene.has_meta("workshop_ready") and scene.get_node("WorldEnvironment")==environment and scene.get_node("Sun")==sun and scene.get_node("FreeCamera")==camera and camera.far==50000,"Original environment/sun/camera identity retained and unrelated workshop never started");scene.queue_free();await process_frame
	for path:String in guards:check(FileAccess.get_sha256(path)==guards[path],"Stable inspection scope dependency "+path)
	FileAccess.open("res://tools/biome_extensions/artifacts/check_cave_inspection_scope.json",FileAccess.WRITE).store_string(JSON.stringify({"passed":failures.is_empty(),"checks":checks,"failures":failures,"source_sha256":guards,"scope":Scope.description()},"  "));print("INSPECTION_SCOPE ",checks," failures=",failures);quit(0 if failures.is_empty() else 1)
