extends "res://tools/biome_extensions/check_all.gd"
const Config=preload("res://scripts/caves/cave_settings.gd")
const Workload=preload("res://scripts/caves/workload.gd")
func run()->void:
	var guards:Dictionary={}
	for path:String in [get_script().resource_path,"res://config/caves/cave_biome_regions.tres","res://config/caves/biomes/default_cave_definition.tres","res://config/caves/biomes/frozen_cave_definition.tres","res://config/caves/cave_settings.tres","res://scripts/caves/workload.gd","res://scripts/caves/field.gd","res://scripts/caves/biome_regions.gd","res://scripts/caves/biome_definition.gd","res://scripts/caves/biome_features.gd","res://scripts/caves/frozen_features.gd"]:guards[path]=FileAccess.get_sha256(path)
	var root_configuration:Resource=load("res://config/caves/cave_settings.tres");var config=Config.new();var ids:Array[String]=[]
	for definition:Resource in config.biome_regions.definitions:ids.append(str(definition.biome_id))
	check(ids==["default","frozen"] and config.validation_errors().is_empty() and root_configuration.validation_errors().is_empty(),"Saved and fresh cave configurations load exactly two fully validated definitions/providers")
	check(not root_configuration.enabled and not config.enabled,"Root cave activation unchanged while later ordered phases remain")
	check(not TerrainSettings.EXTENSION_KEYS.has("snow") and TerrainSettings.EXTENSION_KEYS.size()==8,"Dormant Snow affinity never invents another surface owner")
	var definition:Resource=config.biome_regions.definitions[1];check(definition.spawn_chance_percent==45 and definition.minimum_extent_metres==150 and definition.maximum_extent_metres==700 and definition.depth_preferences==PackedFloat32Array([100,80,40,5,0]),"Registered requested Frozen independent controls—not a preview override")
	var path:String="res://.godot/frozen_registered_roundtrip.tres";check(ResourceSaver.save(config.biome_regions,path)==OK,"Actual editable two-biome registry saved roundtrip");var roundtrip:Resource=ResourceLoader.load(path,"",ResourceLoader.CACHE_MODE_IGNORE);check(roundtrip!=null and roundtrip.validation_errors().is_empty() and roundtrip.definitions.size()==2 and roundtrip.definitions[1].feature_provider.resource_path=="res://scripts/caves/frozen_features.gd","Provider scripts/physical controls survive native resource roundtrip")
	var saved_before:String=FileAccess.get_sha256("res://config/caves/cave_biome_regions.tres");var b=make_builder(3,73921);var baseline=config.duplicate_deep(Resource.DEEP_DUPLICATE_ALL);baseline.biome_regions.definitions.remove_at(1);config.regional_activity=1;baseline.regional_activity=1;var work=Workload.new();var reference=Workload.new();check(work.configure(b.settings,config,73921,0) and reference.configure(b.settings,baseline,73921,0),"Independent registered-two-biome and exact Default-only workers")
	var current:Dictionary=work.network.region(Vector2i(9,-3));var old:Dictionary=reference.network.region(Vector2i(9,-3));check(current.valid and old.valid and var_to_bytes(current)==var_to_bytes(old),"Original Spore graph/rooms/retained water and every Default candidate unchanged where Frozen affinity is zero")
	check(work.use_bundle({"cell":current.id,"regions":[current],"connections":[]}) and reference.use_bundle({"cell":old.id,"regions":[old],"connections":[]}),"Both immutable region bundles compile in same sparse engine")
	var key:=Vector3i(230,0,-64);var a:Dictionary=work.build_cell(key);var c:Dictionary=reference.build_cell(key);check(a.valid and var_to_bytes(a)==var_to_bytes(c),"Complete original positive Default cell payload/frontiers/water unchanged by Frozen registration")
	check(saved_before==FileAccess.get_sha256("res://config/caves/cave_biome_regions.tres") and config.biome_regions.definitions.size()==2 and load("res://config/caves/cave_biome_regions.tres").definitions.size()==2,"Roundtrip/worker/test-only baseline never mutates cached saved registry")
	for source:String in guards:check(FileAccess.get_sha256(source)==guards[source],"Stable saved Frozen registration "+source)
	FileAccess.open("res://tools/biome_extensions/artifacts/check_cave_frozen_registration.json",FileAccess.WRITE).store_string(JSON.stringify({"passed":failures.is_empty(),"checks":checks,"failures":failures,"source_sha256":guards,"registered_ids":ids,"original_default_vertices":a.arrays[Mesh.ARRAY_VERTEX].size(),"root_caves_enabled":root_configuration.enabled,"scope":"Actual saved Default+Frozen registry/provider validation and native roundtrip;root activation remainsfalse. Independent original Spore73921/(9,-3)registered-vs-Default-only complete graph and positive cell payload/frontiers/water exact,all saved resources unchanged. No invented Snow owner. Not full-world/live/current reference-art/all-user completion."},"  "));print("FROZEN_REGISTRATION ",checks," ids=",ids," failures=",failures);quit(0 if failures.is_empty() else 1)
