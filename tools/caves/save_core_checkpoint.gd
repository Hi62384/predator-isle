extends SceneTree
func _initialize()->void:
	var guards:Dictionary={};var reports:Dictionary={};var captures:Dictionary={}
	for name:String in ["check_cave_case_topology_native","check_cave_portal_actual_terrain","check_cave_surface_payload","check_cave_surface_payload_gpu","check_cave_surface_cut","check_cave_surface_transaction","check_cave_production_core","check_cave_workload"]:
		var path:String="res://tools/biome_extensions/artifacts/"+name+".json";var report=JSON.parse_string(FileAccess.get_file_as_string(path));assert(report.passed and report.failures.is_empty());reports[name]={"sha256":FileAccess.get_sha256(path),"checks":report.checks};guards[path]=FileAccess.get_sha256(path)
		for source:String in report.source_sha256:assert(FileAccess.get_sha256(source)==report.source_sha256[source],"Checkpoint source must match accepted proof "+source);guards[source]=report.source_sha256[source]
		for capture:String in report.get("capture_sha256",{}):assert(FileAccess.get_sha256(capture)==report.capture_sha256[capture]);captures[capture]=report.capture_sha256[capture]
	var regression_path:String="res://data/surface_regression_20261018.json";var regression=JSON.parse_string(FileAccess.get_file_as_string(regression_path));assert(regression.passed and regression.test_count==31);guards[regression_path]=FileAccess.get_sha256(regression_path)
	for raw:String in regression.source_sha256:
		var path:String="res://"+raw.replace("\\","/");assert(FileAccess.get_sha256(path)==regression.source_sha256[raw]);guards[path]=regression.source_sha256[raw]
	for source:String in ["res://tools/caves/save_core_checkpoint.gd","res://tools/caves/check_gradient_topology_native.gd","res://tools/caves/check_actual_graph_native.gd","res://config/caves/cave_settings.tres"]:guards[source]=FileAccess.get_sha256(source)
	for name:String in DirAccess.get_files_at("res://scripts/caves"):
		if name.ends_with(".gd"):var path:String="res://scripts/caves/"+name;guards[path]=FileAccess.get_sha256(path)
	FileAccess.open("res://tools/biome_extensions/artifacts/cave_core_integration_checkpoint.json",FileAccess.WRITE).store_string(JSON.stringify({"passed":true,"failures":[],"source_sha256":guards,"capture_sha256":captures,"reports":reports,"production_runtime_enabled":false,"all_user_tasks_complete":false,"status":"Core modules/surface transaction ready for actual terrain-loader integration,not an installed cave system.","limitations":["Native tests preload cells;uninterrupted sparse streaming not yet implemented","Surface transaction proven on controlled native heightfield,not actual ChunkTerrain commit","Frozen/Crystal/Magma cave implementations not started","Conservative350mm analytic floor diagnostic still fails at two ramp midpoints up to450mm;unchanged750mm actual unsupported-drop gate passes at0m on entrance and38.11mm on long underground route","Jolt max-job warning still occurs","Failed exact-equivalence gradient experiment and six-edge intermediate failure remain preserved;final sign-case orientation intentionally repairs winding,not an exact old-output optimization"]},"  "));print("CAVE_CORE_CHECKPOINT ",guards.size()," sources/reports, ",captures.size()," native diagnostic images;runtime remains disabled");quit()
