extends SceneTree
## Development-only deterministic control textures. No runtime generation.
const SIZE:=2048
var noise:=FastNoiseLite.new()
func periodic(x: float,y: float,extent: Vector2) -> float:
	var a:=noise.get_noise_2d(x,y)
	var b:=noise.get_noise_2d(x-extent.x,y)
	var c:=noise.get_noise_2d(x,y-extent.y)
	var d:=noise.get_noise_2d(x-extent.x,y-extent.y)
	return lerpf(lerpf(a,b,x/extent.x),lerpf(c,d,x/extent.x),y/extent.y)*0.5+0.5
func _initialize() -> void:
	noise.seed=41973;noise.frequency=0.016;noise.fractal_octaves=4
	# Cliff assets are now generated by build_fracture_networks.gd.
	for kind in ["grass","meso"]:
		var image:=Image.create(SIZE,SIZE,false,Image.FORMAT_RGBA8)
		for y in range(SIZE):
			var py:=float(y)
			for x in range(SIZE):
				var px:=float(x)
				# No periodic trigonometric patch lattice. Independent irregular
				# fields are baked once; shader placement breaks the tile period.
				var broad:=periodic(px*0.16,py*0.16,Vector2.ONE*SIZE*0.16)
				var detail:=periodic(px*0.73,py*0.73,Vector2.ONE*SIZE*0.73)
				var color: Color
				if kind=="grass":
					var flow:=periodic(float(x)*0.6,float(y)*0.18,Vector2(SIZE*0.6,SIZE*0.18))
					var wear:=(1.0-smoothstep(0.003,0.016,absf(flow-0.49)))*smoothstep(0.60,0.82,broad)
					color=Color(flow,broad,wear,1)
				else:
					var patch:=periodic(px*0.24,py*0.31,Vector2(SIZE*0.24,SIZE*0.31))
					color=Color(smoothstep(0.39,0.66,patch),detail,smoothstep(0.45,0.64,broad),1)
				image.set_pixel(x,y,color)
		image.save_png("res://materials/"+kind+"_mask_preview.png")
		image.generate_mipmaps()
		assert(image.compress_from_channels(Image.COMPRESS_S3TC,Image.USED_CHANNELS_RGBA)==OK)
		var texture:=ImageTexture.create_from_image(image)
		assert(ResourceSaver.save(texture,"res://materials/"+kind+"_macro.res")==OK)
		print("BUILT ",kind," 2048px BC3 mipmapped linear control map")
	quit()
